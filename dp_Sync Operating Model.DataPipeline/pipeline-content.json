{
  "properties": {
    "description": "Operating Model forecast load: resolve -> validate -> clear -> load -> conform -> publish -> notify. Strict sequential chain.",
    "activities": [
      {
        "type": "Lookup",
        "typeProperties": {
          "source": {
            "type": "DataWarehouseSource",
            "sqlReaderQuery": "SELECT TRIM(ScenarioName) AS ScenarioName,\n       TRIM(VersionName)  AS VersionName,\n       CONVERT(varchar(10), ForecastStartMonth, 23) AS ForecastStartMonth\nFROM dbo.sys_scenarios\nWHERE UPPER(TRIM(Status)) = 'ACTIVE'\n  AND UPPER(TRIM(VersionName)) = 'CURRENT FORECAST'",
            "partitionOption": "None",
            "queryTimeout": "02:00:00"
          },
          "datasetSettings": {
            "type": "DataWarehouseTable",
            "schema": [],
            "linkedService": {
              "name": "dw_ovg_internal",
              "properties": {
                "type": "DataWarehouse",
                "typeProperties": {
                  "artifactId": "34ba7523-b692-a5cb-4272-911ff540adf4",
                  "endpoint": "fmvctgbyuzfutjfd36oqzgsglq-7jsaupoloxmulguqkirk2lgpsu.datawarehouse.fabric.microsoft.com",
                  "workspaceId": "00000000-0000-0000-0000-000000000000"
                },
                "annotations": []
              }
            },
            "annotations": []
          },
          "firstRowOnly": false
        },
        "policy": {
          "timeout": "0.02:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureInput": false,
          "secureOutput": false
        },
        "name": "Lookup Active Scenario",
        "dependsOn": []
      },
      {
        "type": "IfCondition",
        "typeProperties": {
          "expression": {
            "value": "@equals(activity('Lookup Active Scenario').output.count, 1)",
            "type": "Expression"
          },
          "ifTrueActivities": [
            {
              "type": "SetVariable",
              "typeProperties": {
                "variableName": "Scenario",
                "value": {
                  "value": "@activity('Lookup Active Scenario').output.value[0].ScenarioName",
                  "type": "Expression"
                }
              },
              "policy": {
                "secureInput": false,
                "secureOutput": false
              },
              "name": "Set Scenario",
              "dependsOn": []
            },
            {
              "type": "SetVariable",
              "typeProperties": {
                "variableName": "Version",
                "value": {
                  "value": "@activity('Lookup Active Scenario').output.value[0].VersionName",
                  "type": "Expression"
                }
              },
              "policy": {
                "secureInput": false,
                "secureOutput": false
              },
              "name": "Set Version",
              "dependsOn": []
            },
            {
              "type": "SetVariable",
              "typeProperties": {
                "variableName": "ForecastStart",
                "value": {
                  "value": "@coalesce(activity('Lookup Active Scenario').output.value[0].ForecastStartMonth, '')",
                  "type": "Expression"
                }
              },
              "policy": {
                "secureInput": false,
                "secureOutput": false
              },
              "name": "Set Forecast Start",
              "dependsOn": []
            }
          ],
          "ifFalseActivities": [
            {
              "type": "Fail",
              "typeProperties": {
                "message": {
                  "value": "@concat('sys_scenarios must return exactly one Active / Current Forecast row; returned ', string(activity('Lookup Active Scenario').output.count), '. Nothing was cleared or loaded.')",
                  "type": "Expression"
                },
                "errorCode": "SCENARIO_NOT_RESOLVED"
              },
              "name": "Fail Scenario Not Resolved",
              "dependsOn": []
            }
          ]
        },
        "name": "If Exactly One Active Scenario",
        "dependsOn": [
          {
            "activity": "Lookup Active Scenario",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      },
      {
        "type": "IfCondition",
        "typeProperties": {
          "expression": {
            "value": "@not(empty(variables('ForecastStart')))",
            "type": "Expression"
          },
          "ifTrueActivities": [],
          "ifFalseActivities": [
            {
              "type": "Fail",
              "typeProperties": {
                "message": {
                  "value": "@concat('ForecastStartMonth is NULL for ', variables('Scenario'), ' / ', variables('Version'), '. Nothing was cleared or loaded.')",
                  "type": "Expression"
                },
                "errorCode": "FORECAST_START_MISSING"
              },
              "name": "Fail Forecast Start Missing",
              "dependsOn": []
            }
          ]
        },
        "name": "If Forecast Start Present",
        "dependsOn": [
          {
            "activity": "If Exactly One Active Scenario",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      },
      {
        "type": "RefreshDataflow",
        "typeProperties": {
          "dataflowId": "a1a62a3e-986f-9a4c-4928-fb5e83c001b4",
          "workspaceId": "00000000-0000-0000-0000-000000000000",
          "notifyOption": "NoNotification",
