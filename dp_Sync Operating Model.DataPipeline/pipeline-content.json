      {
        "type": "Office365Email",
        "typeProperties": {
          "body": {
            "value": "<p><b>Result: SUCCEEDED.</b> The forecast is published to out_income_statement and is live in Power BI.@{if(greater(int(activity('Lookup Run Summary').output.firstRow.UnresolvedRows), 0), ' <b>Action needed: some customer or vendor names could not be resolved - see below.</b>', '')}</p>\n<table border=\"1\" cellpadding=\"4\" cellspacing=\"0\">\n<tr><td>Slice (Scenario / Version / Source)</td><td>@{variables('Scenario')} / @{variables('Version')} / @{pipeline().parameters.SourceModel}</td></tr>\n<tr><td>Rows replaced in out_income_statement</td><td>@{activity('Lookup Run Summary').output.firstRow.RowsReplaced}</td></tr>\n<tr><td>Rows published</td><td>@{activity('Lookup Run Summary').output.firstRow.RowsPublished}</td></tr>\n<tr><td>Workbook ControlTotal (tied to staging before publish)</td><td>@{variables('ControlTotal')}</td></tr>\n<tr><td>Expected ledger total (after sign flip)</td><td>@{activity('Lookup Run Summary').output.firstRow.ExpectedLedgerTotal}</td></tr>\n<tr><td>Published ledger total (read back from out_income_statement)</td><td>@{activity('Lookup Run Summary').output.firstRow.PublishedLedgerTotal}</td></tr>\n<tr><td>New customers / vendors added</td><td>@{activity('Lookup Run Summary').output.firstRow.NewDimMembers}</td></tr>\n<tr><td>Names conformed to existing spelling</td><td>@{activity('Lookup Run Summary').output.firstRow.NamesConformed}</td></tr>\n<tr><td>Unresolved customer / vendor rows</td><td>@{activity('Lookup Run Summary').output.firstRow.UnresolvedRows} - @{activity('Lookup Run Summary').output.firstRow.UnresolvedSample}</td></tr>\n</table>\n<p>Pipeline: dp_Sync Operating Model. Run ID: @{pipeline().RunId}<br/>Workspace: <a href=\"https://app.fabric.microsoft.com/groups/3d0a64fa-75cb-45d9-9a90-5222ad2ccf95/list?experience=fabric-developer\">OVG Training Workspace - SO</a> (Monitor hub, filter by run ID)</p>",
            "type": "Expression"
          },
          "to": "shane.oneill@openvalegroup.com",
          "subject": {
            "value": "@{if(greater(int(activity('Lookup Run Summary').output.firstRow.UnresolvedRows), 0), '[SUCCEEDED - ACTION NEEDED]', '[SUCCEEDED]')} Operating Model forecast load - @{variables('Scenario')} / @{variables('Version')}",
            "type": "Expression"
          }
        },
