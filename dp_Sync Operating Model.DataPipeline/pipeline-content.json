        "name": "Read Workbook Validation",
        "dependsOn": [
          {
            "activity": "If Forecast Start Present",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      },
      {
        "type": "Lookup",
        "typeProperties": {
          "source": {
            "type": "DataWarehouseSource",
            "sqlReaderQuery": {
              "value": "SELECT COUNT(*) AS RowsForRun,\n       MAX(ErrorCount) AS ErrorCountText,\n       ISNULL(TRY_CAST(MAX(ErrorCount) AS int), -1) AS ErrorCountNum,\n       MAX(ControlTotal) AS ControlTotal,\n       CASE WHEN TRY_CAST(MAX(ControlTotal) AS decimal(18,4)) IS NULL THEN 0 ELSE 1 END AS ControlTotalIsNumber,\n       ISNULL(MAX(SourceId), '') AS SourceId,\n       ISNULL(MAX(ScenarioId), '') AS ScenarioId,\n       ISNULL(MAX(FileName), 'Operating Model workbook') AS FileName\nFROM dbo.stg_workbook_validation\nWHERE RunId = '@{pipeline().RunId}'\n  AND SourceModel = '@{pipeline().parameters.SourceModel}'",
              "type": "Expression"
            },
            "partitionOption": "None",
            "queryTimeout": "02:00:00"
          },
          "datasetSettings": {
            "type": "DataWarehouseTable",
            "schema": [],
            "linkedService": {
              "name": "dw_ovg_internal",
              "properties": {
                "type": "DataWarehouse",
                "typeProperties": {
                  "artifactId": "34ba7523-b692-a5cb-4272-911ff540adf4",
                  "endpoint": "fmvctgbyuzfutjfd36oqzgsglq-7jsaupoloxmulguqkirk2lgpsu.datawarehouse.fabric.microsoft.com",
                  "workspaceId": "00000000-0000-0000-0000-000000000000"
                },
                "annotations": []
              }
            },
            "annotations": []
          },
          "firstRowOnly": true
        },
        "policy": {
          "timeout": "0.02:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureInput": false,
          "secureOutput": false
        },
        "name": "Lookup Validation Row",
        "dependsOn": [
          {
            "activity": "Read Workbook Validation",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      },
      {
        "type": "IfCondition",
        "typeProperties": {
          "expression": {
            "value": "@and(equals(int(activity('Lookup Validation Row').output.firstRow.RowsForRun), 1), and(equals(int(activity('Lookup Validation Row').output.firstRow.ErrorCountNum), 0), and(equals(int(activity('Lookup Validation Row').output.firstRow.ControlTotalIsNumber), 1), and(equals(activity('Lookup Validation Row').output.firstRow.SourceId, pipeline().parameters.SourceModel), equals(activity('Lookup Validation Row').output.firstRow.ScenarioId, variables('Scenario'))))))",
            "type": "Expression"
          },
          "ifTrueActivities": [
            {
              "type": "SetVariable",
              "typeProperties": {
                "variableName": "ControlTotal",
                "value": {
                  "value": "@string(activity('Lookup Validation Row').output.firstRow.ControlTotal)",
                  "type": "Expression"
                }
              },
              "policy": {
                "secureInput": false,
                "secureOutput": false
              },
              "name": "Set Control Total",
              "dependsOn": []
            }
          ],
          "ifFalseActivities": [
            {
              "type": "Fail",
              "typeProperties": {
                "message": {
                  "value": "@concat('Workbook validation failed for ', activity('Lookup Validation Row').output.firstRow.FileName, ': ErrorCount=', coalesce(activity('Lookup Validation Row').output.firstRow.ErrorCountText, '<missing>'), ', SourceId=', activity('Lookup Validation Row').output.firstRow.SourceId, ' (expected ', pipeline().parameters.SourceModel, '), ScenarioId=', activity('Lookup Validation Row').output.firstRow.ScenarioId, ' (expected ', variables('Scenario'), '), rows for this run=', string(activity('Lookup Validation Row').output.firstRow.RowsForRun), '. Nothing was cleared or loaded.')",
                  "type": "Expression"
                },
                "errorCode": "WORKBOOK_VALIDATION_FAILED"
              },
              "name": "Fail Workbook Validation",
              "dependsOn": []
            }
          ]
        },
        "name": "If Workbook Valid",
        "dependsOn": [
          {
            "activity": "Lookup Validation Row",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      },
