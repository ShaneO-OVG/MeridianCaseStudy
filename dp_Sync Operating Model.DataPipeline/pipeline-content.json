      {
        "type": "Lookup",
        "typeProperties": {
          "source": {
            "type": "DataWarehouseSource",
            "sqlReaderQuery": {
              "value": "SELECT\n  ISNULL(MAX(CASE WHEN ProcName = 'sp_clear_fcst_income_statement' THEN RowsDeleted  END), 0) AS StagingRowsCleared,\n  ISNULL(MAX(CASE WHEN ProcName = 'sp_add_customers_and_vendors'   THEN RowsInserted END), 0) AS NewDimMembers,\n  ISNULL(MAX(CASE WHEN ProcName = 'sp_add_customers_and_vendors'   THEN RowsUpdated  END), 0) AS NamesConformed,\n  ISNULL(MAX(CASE WHEN ProcName = 'sp_add_customers_and_vendors'   THEN UnmappedRows END), 0) AS UnresolvedRows,\n  ISNULL(MAX(CASE WHEN ProcName = 'sp_add_customers_and_vendors' AND CHARINDEX('UNRESOLVED', ScopeSourceModels) > 0\n                  THEN SUBSTRING(ScopeSourceModels, CHARINDEX('UNRESOLVED', ScopeSourceModels), 4000) END), 'None') AS UnresolvedSample,\n  ISNULL(MAX(CASE WHEN ProcName = 'sp_publish_income_statement'    THEN RowsDeleted  END), 0) AS RowsReplaced,\n  ISNULL(MAX(CASE WHEN ProcName = 'sp_publish_income_statement'    THEN RowsInserted END), 0) AS RowsPublished,\n  CONVERT(varchar(40), ISNULL(MAX(CASE WHEN ProcName = 'sp_publish_income_statement' THEN ExpectedAmount  END), 0)) AS ExpectedLedgerTotal,\n  CONVERT(varchar(40), ISNULL(MAX(CASE WHEN ProcName = 'sp_publish_income_statement' THEN PublishedAmount END), 0)) AS PublishedLedgerTotal\nFROM dbo.sys_publish_audit\nWHERE RunId = '@{pipeline().RunId}'",
              "type": "Expression"
            },
            "partitionOption": "None",
            "queryTimeout": "02:00:00"
          },
          "datasetSettings": {
            "type": "DataWarehouseTable",
            "schema": [],
            "linkedService": {
              "name": "dw_ovg_internal",
              "properties": {
                "type": "DataWarehouse",
                "typeProperties": {
                  "artifactId": "34ba7523-b692-a5cb-4272-911ff540adf4",
                  "endpoint": "fmvctgbyuzfutjfd36oqzgsglq-7jsaupoloxmulguqkirk2lgpsu.datawarehouse.fabric.microsoft.com",
                  "workspaceId": "00000000-0000-0000-0000-000000000000"
                },
                "annotations": []
              }
            },
            "annotations": []
          },
          "firstRowOnly": true
